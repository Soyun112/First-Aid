# 프론트엔드 환경변수 (Vite)
# 로컬: 프로젝트 루트에 .env 로 복사 후 npm run dev 재시작
# Vercel: Project → Settings → Environment Variables → Redeploy

# Render 백엔드 (Gemini API 키는 여기 서버에만 존재 — 프론트 노출 금지)
VITE_API_URL=https://first-aid-77zc.onrender.com

# ETA 예측 서버 (로컬: uvicorn main:app --port 8001)
VITE_ETA_API_URL=http://localhost:8001

# 프론트에 VITE_GEMINI_API_KEY 를 두지 마세요.
# 키는 Render Environment: GEMINI_API_KEY
